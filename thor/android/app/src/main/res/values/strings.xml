    <!-- Data sheet -->
    <string name="sheet_title">Game data setup</string>
    <string name="sheet_intro">Thor Conquer uses the original game files from your own copy of the C&amp;C Remastered Collection (Steam). No game data is included or downloaded.</string>
    <string name="sheet_where">COPY THE FILES TO</string>
    <string name="sheet_ra_files">RED ALERT · from Data/CNCDATA/RED_ALERT</string>
    <string name="sheet_td_files">TIBERIAN DAWN · from Data/CNCDATA/TIBERIAN_DAWN</string>
    <string name="sheet_td_layout">CD1 files go into the folder itself. Put GENERAL.MIX and MOVIES.MIX from CD1 into gdi/ and from CD2 into nod/ to play both campaigns.</string>
    <string name="sheet_adb">FROM A COMPUTER (ADB)</string>
    <string name="sheet_adb_hint">The repository contains thor/copy-data.sh, which copies everything from a Steam install on the device in one step.</string>
    <string name="sheet_note">File names are not case-sensitive. Uninstalling the app deletes this folder; updating it does not.</string>
    <string name="close">CLOSE</string>

    <string name="missing_title">Game data missing</string>
    <string name="missing_body">%1$s cannot start. These files are missing:\n\n%2$s\n\nCopy them to:\n%3$s</string>
    <string name="ok">OK</string>

    <string name="about_title">About Thor Conquer</string>
    <string name="about_body">Thor Conquer is a native Android build of Vanilla Conquer for the AYN Thor, with a command deck on the second screen.\n\nBased on Vanilla Conquer (TheAssemblyArmada) and the Android fork by sandstranger, both built on the source code Electronic Arts released under GPL-3.0. Licensed under GPL-3.0.\n\nFonts: Inter and JetBrains Mono, SIL Open Font License 1.1.\n\nCommand &amp; Conquer, Red Alert and Tiberian Dawn are trademarks of Electronic Arts Inc. This project is not affiliated with or endorsed by Electronic Arts.</string>

